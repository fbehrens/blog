---
// Cloudflare Web Analytics — cookieless, privacy-first, no consent required.
// Set PUBLIC_CF_BEACON_TOKEN (from the Cloudflare dashboard) to enable.
const TOKEN = import.meta.env.PUBLIC_CF_BEACON_TOKEN;
---
{TOKEN && (
  <script
    is:inline
    defer
    src="https://static.cloudflareinsights.com/beacon.min.js"
    data-cf-beacon={JSON.stringify({ token: TOKEN })}
  ></script>
)}
