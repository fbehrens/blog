---
import Layout from '../../layouts/Layout.astro';
import { getMissions } from '../../lib/missions';

const missions = getMissions();
const linkClass = 'text-(--color-primary) underline hover:text-(--color-primary-hover)';
---
<Layout title="Teach" description="Learning missions, published from my teach workspace.">
  <header class="mb-8">
    <h1 class="font-serif text-3xl font-bold leading-snug mb-2">Teach</h1>
    <p class="text-(--color-muted)">
      Self-directed learning missions — each with interactive lessons and references.
    </p>
    <p class="mt-3 text-sm text-(--color-muted) border-l-2 border-(--color-border) pl-3">
      These are my own private learning sessions, generated with the
      <a href="https://github.com/mattpocock/skills" target="_blank" rel="noopener noreferrer"
        class="text-(--color-primary) underline hover:text-(--color-primary-hover)">/teach </a>
      skill from my <a href="https://www.aihero.dev" target="_blank" rel="noopener noreferrer"
        class="text-(--color-primary) underline hover:text-(--color-primary-hover)">AI Hero</a> Matt Pocock .
      I publish them here as a personal record, and to showcase the state of LLMs, not as polished tutorials.
    </p>
  </header>

  <div>
    {missions.map(m => (
      <article class="py-6 border-b border-(--color-border) last:border-0">
        <h2 class="font-serif text-xl font-semibold mb-1">{m.title}</h2>
        {m.why && <p class="text-(--color-muted) text-sm leading-relaxed mb-3">{m.why}</p>}
        {m.lessons.length > 0 && (
          <>
            <h3 class="text-sm font-semibold mt-3 mb-1">Lessons</h3>
            <ol class="list-decimal pl-5 space-y-1 text-sm">
              {m.lessons.map(l => <li><a href={l.href} class={linkClass}>{l.title}</a></li>)}
            </ol>
          </>
        )}
        {m.references.length > 0 && (
          <>
            <h3 class="text-sm font-semibold mt-3 mb-1">References</h3>
            <ul class="list-disc pl-5 space-y-1 text-sm">
              {m.references.map(r => <li><a href={r.href} class={linkClass}>{r.title}</a></li>)}
            </ul>
          </>
        )}
      </article>
    ))}
    {missions.length === 0 && (
      <p class="text-(--color-muted)">No missions published yet.</p>
    )}
  </div>
</Layout>
