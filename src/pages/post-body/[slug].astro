---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---
<div class="prose prose-neutral max-w-none
  [&_h2]:font-serif [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:mt-8 [&_h2]:mb-3
  [&_h3]:font-serif [&_h3]:text-xl [&_h3]:font-semibold [&_h3]:mt-6 [&_h3]:mb-2
  [&_p]:mb-4 [&_p]:leading-7 [&_p]:text-[oklch(20%_0_0)]
  [&_a]:text-(--color-primary) [&_a]:underline [&_a:hover]:text-(--color-primary-hover)
  [&_ul]:list-disc [&_ul]:pl-5 [&_ul]:mb-4
  [&_ol]:list-decimal [&_ol]:pl-5 [&_ol]:mb-4
  [&_li]:mb-1
  [&_code]:bg-(--color-primary-light) [&_code]:px-1 [&_code]:rounded [&_code]:text-sm
  [&_pre_code]:bg-transparent [&_pre_code]:p-0 [&_pre_code]:rounded-none [&_pre_code]:text-base
  [&_pre]:bg-[oklch(15%_0_0)] [&_pre]:text-white [&_pre]:p-4 [&_pre]:rounded-lg [&_pre]:overflow-x-auto [&_pre]:mb-4
  [&_blockquote]:border-l-4 [&_blockquote]:border-(--color-primary) [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-(--color-muted)
  [&_img]:rounded-lg [&_img]:my-6">
  <Content />
</div>
